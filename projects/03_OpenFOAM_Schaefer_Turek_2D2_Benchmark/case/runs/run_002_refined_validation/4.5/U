                field[i] = vector(ux, 0, 0);
            }
        #};
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            zeroGradient;
    }
    cylinder
    {
        type            noSlip;
    }
}


