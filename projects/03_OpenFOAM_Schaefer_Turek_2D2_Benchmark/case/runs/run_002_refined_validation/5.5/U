            forAll(field, i)
            {
                const scalar y = boundaryPatch.Cf()[i].y();
                const scalar ux = 4.0*Um*y*(H - y)/(H*H);
                field[i] = vector(ux, 0, 0);
            }
        #};
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            zeroGradient;
    }
    cylinder
    {
        type            noSlip;
    }
}


