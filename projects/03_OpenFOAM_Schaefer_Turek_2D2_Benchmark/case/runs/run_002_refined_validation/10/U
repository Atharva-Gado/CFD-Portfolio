        name            parabolicInlet;
        code            #{
            const scalar H = 0.41;
            const scalar Um = 1.5;

            const fvPatch& boundaryPatch = patch();
            vectorField& field = *this;

            forAll(field, i)
            {
                const scalar y = boundaryPatch.Cf()[i].y();
                const scalar ux = 4.0*Um*y*(H - y)/(H*H);
                field[i] = vector(ux, 0, 0);
            }
